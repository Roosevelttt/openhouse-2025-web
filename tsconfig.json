{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["svelte"],
    "strict": true
  },
  "include": [
    "src/**/*",
    "svelte.config.js",
    "vite.config.ts",
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/non-ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts"
  ],
  "exclude": ["node_modules/*"]
}

